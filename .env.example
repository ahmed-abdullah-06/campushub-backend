PORT=5000
# secretlint-disable-next-line
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campushub?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
CLIENT_URL=http://localhost:5173

# Public base URL of this API (used to build image URLs behind a proxy)
# PUBLIC_URL=https://campushub-api.example.com

# Upload storage: 'gridfs' stores files in MongoDB (survives redeploys — set
# this on any cloud host), 'local' saves them to backend/uploads on disk.
# Defaults to gridfs in production, local in development.
# UPLOAD_STORAGE=gridfs

# Outbound email (password reset + notification emails).
# Without these, emails are printed to the server console (dev mode).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=smtp-user
# SMTP_PASS=smtp-password
# EMAIL_FROM=CampusHub <no-reply@campushub.example.com>